# Backend порт 8080.
HTTP_ADDR=:8080

# Адрес frontend
FRONTEND_ORIGIN=https://nexlysocial.ru
FRONTEND_URL=https://nexlysocial.ru

# Для HTTPS поменять на true.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# DATABASE
DATABASE_URL=postgres:postgres://kvmm:{password}@postgres:5432/kvmm?sslmode=disable
POSTGRES_DB=kvmm
POSTGRES_USER=kvmm
POSTGRES_PASSWORD=password

# Папка загруженных файлов и публичный URL медиа
MEDIA_DIR=/data/media
MEDIA_PUBLIC_URL=/api/media

# Режим логирования: debug — подробные логи, prod — только необходимые
LOG_MODE=prod
